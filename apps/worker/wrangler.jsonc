{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iptv-llr",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "CHANNELS",
      "id": "ea9dfb35ef28430f832386ad1a7d30b9"
    }
  ],
  "routes": [
    {
      "pattern": "neycbs.de5.net",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "UPSTREAM_URLS": "https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/result.m3u https://iptv-org.github.io/iptv/countries/cn.m3u https://iptv-org.github.io/iptv/countries/int.m3u https://iptv-org.github.io/iptv/countries/us.m3u https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8"
  }
}
