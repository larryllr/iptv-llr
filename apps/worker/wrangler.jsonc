{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iptv-llr",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "CHANNELS",
      "id": "REPLACE_WITH_PRODUCTION_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "UPSTREAM_URL": "https://raw.githubusercontent.com/imzyb/iptv-api/main/output/result.m3u"
  }
}
